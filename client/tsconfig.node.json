// Ví dụ logic kết nối trực tiếp qua Socket TCP trong Android
import java.net.Socket;
import java.io.OutputStream;
import java.io.InputStream;

public void connectDirectToMinecraft(String serverIp, int port, String username) {
    new Thread(new Runnable() {
        @Override
        public void run() {
            try {
                // Kết nối trực tiếp tới server Minecraft (Cổng mặc định là 25565)
                Socket socket = new Socket(serverIp, port);
                
                // Tại đây bạn cần tự cài đặt bộ lọc gói tin (Packet Handshaking, Login) 
                // theo giao thức của phiên bản Minecraft tương ứng.
                
                Log.d("DirectConnect", "Đã kết nối thành công tới server Minecraft!");
            } catch (Exception e) {
                Log.e("DirectConnect", "Lỗi kết nối trực tiếp: " + e.getMessage());
            }
        }
    }).start();
}
